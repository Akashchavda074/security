# Supabase Project Settings → API
# Newer dashboard labels map like this:
#   Project URL              → NEXT_PUBLIC_SUPABASE_URL
#   Publishable / anon key   → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Secret / service_role    → SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_service_role_key_here
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Keep true for local UI testing without Supabase Auth.
# Set false after real login is wired.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
NEXT_PUBLIC_APP_NAME=Security Management PWA
NEXT_PUBLIC_APP_URL=http://localhost:3000

CRON_SECRET=change-me-for-hourly-verification-cron
